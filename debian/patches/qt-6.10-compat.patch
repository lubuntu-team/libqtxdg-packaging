---
This patch header follows DEP-3: http://dep.debian.net/deps/dep3/
--- a/util/CMakeLists.txt
+++ b/util/CMakeLists.txt
@@ -20,10 +20,6 @@ target_include_directories(qtxdg-desktop
     PRIVATE "${PROJECT_SOURCE_DIR}/qtxdg"
 )
 
